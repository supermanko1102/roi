DATABASE_URL=postgres://roi:roi@localhost:5432/taoyuan_roi

# Google AI Studio authentication used by ADK.
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# New agents use the Gemini 3 series. Override only when intentionally testing
# another supported model.
ADDRESS_AGENT_MODEL=gemini-3-flash-preview

# Defaults to the parent of this folder.
ROI_REPO_ROOT=..

# Optional manual publishing stays disabled; the unattended runner uses a separate gate.
ADDRESS_AGENT_ALLOW_PUBLISH=0
